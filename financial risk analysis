import yfinance as yf
import pandas as pd
import numpy as np
import datetime as dt
import matplotlib.pyplot as plt
import os


enddate = dt.datetime.now()

startdate = enddate - dt.timedelta(days= 365*5)

stocks = ['HDFCBANK.NS', 'SBIN.NS', '^NSEBANK']
df = yf.download(stocks, start= startdate, end=enddate)
closed_prices = df['Close']
log_returns = np.log(closed_prices/closed_prices.shift(1))
volatility= log_returns.std()*np.sqrt(252)
annualised_returns=log_returns.mean()*(252)
risk_free_rate= 0.065
sharpe_ratio=((annualised_returns-risk_free_rate)/volatility)
cumulative_log_returns = log_returns.cumsum()
print("5 year quantitative risk report")
print(enddate,startdate)
print("Annualised Returns")
print(round(annualised_returns*100,2).astype(str)+"%")
print("Volatility")
print(round(volatility*100,2).astype(str)+"%")
print("Sum of total returns")
print(log_returns.sum())
print("Sharpe ratio")
print(sharpe_ratio)
plt.style.use('fivethirtyeight')
cumulative_log_returns.plot(title="cumulative returns", figsize=(10,6))
plt.figure(figsize=(15,8))
plt.axhline(0, color='black', linewidth=2)
sharpe_ratio.plot(kind= "bar" ,title="share ratio", color=["blue","red","green"])
plt.tight_layout()
plt.show()
